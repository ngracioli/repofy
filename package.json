{
  "name": "repofy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
